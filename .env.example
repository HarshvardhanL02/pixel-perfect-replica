# MediResQ Environment Configuration Example
# Copy this file to .env and configure for your environment.

# External Drone Nav AI application URL (e.g. http://localhost:3000 or https://drone-nav-ai.example.com)
VITE_DRONE_NAV_AI_URL=http://localhost:3000

# External AI model server base URL (production Hugging Face ZeroGPU space or local http://localhost:8000)
VITE_DETECTION_API_URL=https://infonitiate-mediresq-ai.hf.space
